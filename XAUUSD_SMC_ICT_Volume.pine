i_bull = input.color(#26a69a, "Bullish", group = G_DSP, inline = "c1")
i_bear = input.color(#ef5350, "Bearish", group = G_DSP, inline = "c1")
i_colBsl = input.color(#ef9a9a, "BSL", group = G_DSP, inline = "c2")
