i_alZone = input.bool(true, "Alerts: new FVG / OB", group = G_ALT)
i_alVol = input.bool(true, "Alerts: volume spike / volume-confirmed displacement", group = G_ALT)
i_alA = input.bool(true, "Alerts: A setups", group = G_ALT)
i_alAp = input.bool(true, "Alerts: A+ setups", group = G_ALT)
