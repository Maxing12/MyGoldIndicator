i_tpMode = input.string("Liquidity", "Take-profit method", options = ["Liquidity", "Fixed RR"], group = G_RSK, tooltip = "Liquidity: nearest un-taken pools, falling back to fixed RR multiples when none qualify.")
i_tp1MinR = input.float(0.8, "TP1 minimum distance (R)", minval = 0.2, step = 0.1, group = G_RSK)
i_rr1 = input.float(1.5, "Fallback / fixed TP1 (R)", minval = 0.5, step = 0.1, group = G_RSK)
