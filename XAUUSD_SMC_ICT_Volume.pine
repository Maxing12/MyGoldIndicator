i_maxStruct = input.int(30, "Max structure lines/labels", minval = 5, maxval = 80, group = G_DSP)
i_maxMarks = input.int(30, "Max sweep/other marks", minval = 5, maxval = 80, group = G_DSP)
i_maxSetupVis = input.int(4, "Max setups with visuals", minval = 1, maxval = 10, group = G_DSP)
i_dashOn = input.bool(true, "Dashboard", group = G_DSP)
i_dashPos = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = G_DSP)
i_dashSize = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal"], group = G_DSP)
i_anaOn = input.bool(true, "Analytics table (post-signal outcomes)", group = G_DSP)
i_anaRank = input.string("A+", "Analytics counts setups of grade ≥", options = ["B", "A", "A+"], group = G_DSP)
i_journal = input.bool(true, "Show last-setup journal in dashboard", group = G_DSP)

i_alStruct = input.bool(true, "Alerts: BOS / CHoCH / MSS", group = G_ALT)
