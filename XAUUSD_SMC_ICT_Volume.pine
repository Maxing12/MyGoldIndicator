//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════
//  XAUUSD  SMC + ICT + VOLUME  —  structured setup engine (Pine Script v6)
//  Flow: HTF bias → premium/discount → liquidity → sweep → MSS/CHoCH → displacement →
//        FVG/OB → retracement → entry → structural SL → liquidity targets
//
//  IMPORTANT LIMITATIONS (read before use)
//   1. SMC/ICT concepts are partly discretionary.
//   2. Different traders define BOS, CHoCH, MSS, FVG and OB differently.
//   3. This script converts those concepts into predefined mathematical rules (see
//      docs/SPECIFICATION.md); they will not match every trader's reading of the chart.
//   4. XAUUSD spot "volume" on TradingView is usually TICK volume, not centralized
//      exchange volume.
//   5. High volume does not by itself indicate buying or selling.
//   6. Historical performance does not guarantee future performance. Analytics are
//      theoretical, bar-based and ignore spread, slippage, commission and fills.
//   7. News events can produce abnormal Gold volatility. Pine cannot read an economic
//      calendar; only manual news windows are offered.
//   8. This is an analytical tool, not an autonomous trading system.
//   9. Signals ("Confluence Score" grades) are technical-alignment labels, not
//      probabilities. Evaluate every setup independently and manage your own risk.
//
//  NON-REPAINTING DESIGN
//   • Swings are confirmed pivots (delay = pivot length bars). Nothing is drawn from a
//     pivot before it is confirmed.
//   • All state-mutating logic runs only on closed bars (barstate.isconfirmed), so
//     history and realtime behave identically.
//   • HTF data uses request.security(..., expr[1], lookahead_on): the last COMPLETED HTF bar.
//   • "Show Developing Signals" only adds a text row to the dashboard; it never draws.
// ═══════════════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────── 1. DECLARATION ──────────────────────────────────────
indicator(title = "XAUUSD SMC + ICT + Volume", shorttitle = "XAU SMC", overlay = true, max_bars_back = 500, max_boxes_count = 200, max_lines_count = 300, max_labels_count = 300)

// ───────────────────────────────── 2. CONSTANTS / TYPES ────────────────────────────────
const int S_PEND = 0
const int S_ENTERED = 1
const int S_TP3 = 2
const int S_SL = 3
const int S_EXP = 4
const int S_INV = 5
const int S_TIMEOUT = 6

type Liq
    float price
    int bar
    bool isBuy
    string kind
    int weight
    line ln
    label lb

type Fvg
    float top
    float bot
    bool bull
    int bar
    int state = 0
    int strength = 0
    box bx

type Ob
    float top
    float bot
    bool bull
    int bar
    int candleBar
    int state = 0
    int strength = 0
    bool breaker = false
    box bx

type Cand
    bool armed = false
    int sweepBar = -1
    float sweepExt
    float legExt
    int weight = 0
    string kind = ""
    float sweepRvol = 0.0
    int mssBar = -1
    bool isMss = false
    int dispLvl = 0
    float dispRvol = 0.0

type Setup
    int num
    bool isLong
    string grade
    int score
    int maxScore
    float entryTop
    float entryBot
    float entryRef
    float sl
    float tp1
    float tp2
    float tp3
    float rr
    float rvol
    int bar
    int fillBar = -1
    int status = 0
    bool tp1Hit = false
    bool tp2Hit = false
    bool tp3Hit = false
    string txt
    box zoneBx
    line slLn
    line t1Ln
    line t2Ln
    line t3Ln
    label lb
    label slLb
    label t1Lb
    label t2Lb
    label t3Lb

type Stats
    int count = 0
    int n = 0
    int nLong = 0
    int nShort = 0
    int entered = 0
    int tp1 = 0
    int tp2 = 0
    int tp3 = 0
    int sl = 0
    int slAfter = 0
    int exp = 0
    int inv = 0
    float sumRR = 0.0
    float sumScore = 0.0
    float sumRv = 0.0
    int rvN = 0

type Ev
    bool bosUp = false
    bool bosDn = false
    bool chUp = false
    bool chDn = false
    bool mssUp = false
    bool mssDn = false
    bool bsl = false
    bool ssl = false
    bool fvgUp = false
    bool fvgDn = false
    bool obUp = false
    bool obDn = false
    bool dispVol = false
    bool aLong = false
    bool aShort = false
    bool apLong = false
    bool apShort = false
    bool inval = false
    bool tp1 = false
    bool tp2 = false
    bool tp3 = false

// ───────────────────────────────── 3. INPUTS ───────────────────────────────────────────
G_GEN = "01 General"
G_STR = "02 Market Structure"
G_LIQ = "03 Liquidity"
G_FVG = "04 FVG / Displacement"
G_OB = "05 Order Blocks"
G_PD = "06 Premium / Discount / OTE"
G_SES = "07 Sessions / Kill Zones"
G_VOL = "08 Volatility"
G_VLM = "09 Volume"
G_CNF = "10 Confluence / Preset values"
G_RSK = "11 Risk / Entry"
G_DSP = "12 Display"
G_ALT = "13 Alerts"
G_HTF = "14 Higher-Timeframe Bias"
G_NWS = "15 Manual News Risk"

i_enable = input.bool(true, "Enable indicator", group = G_GEN)
i_preset = input.string("Balanced", "Preset", options = ["Conservative", "Balanced", "Aggressive", "Custom"], group = G_GEN, tooltip = "Presets override thresholds (score, RR, gates, FVG/OB filters). 'Custom' uses the values in group 10.")
i_sens = input.string("Follow Preset", "Swing sensitivity", options = ["Follow Preset", "Conservative", "Balanced", "Aggressive", "Manual"], group = G_GEN, tooltip = "Pivot lengths. 'Manual' uses the lengths below.")
i_showDev = input.bool(false, "Show Developing Signals (dashboard text only)", group = G_GEN, tooltip = "Adds a dashboard row with information from the still-open candle. It never draws objects and never affects setups.")

i_majorLen = input.int(10, "Major swing length (manual)", minval = 2, group = G_STR)
i_minorLen = input.int(5, "Minor swing length (manual)", minval = 2, group = G_STR)
i_intLen = input.int(3, "Internal swing length (manual)", minval = 1, group = G_STR)
